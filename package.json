{
  "name": "bp-math",
  "version": "2.0.0",
  "description": "基于 decimal.js 封装的轻量高精度数学工具库",
  "type": "module",
  "main": "./build/index.cjs",
  "module": "./build/index.js",
  "types": "./build/types/main.d.ts",
  "exports": {
    ".": {
      "types": "./build/types/main.d.ts",
      "import": "./build/index.js",
      "require": "./build/index.cjs"
    }
  },
  "files": [
    "build"
  ],
  "sideEffects": false,
  "scripts": {
    "dev": "vitest",
    "build": "node scripts/clean-build.mjs && rollup -c",
    "test:build": "node scripts/test-build.mjs",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm build && pnpm test:build",
    "prepublishOnly": "pnpm check"
  },
  "keywords": [
    "blockpulse",
    "blockpulse_dapp",
    "decimal.js"
  ],
  "author": "BpMath contributors",
  "license": "ISC",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@rollup/plugin-terser": "^0.4.1",
    "@rollup/plugin-typescript": "^11.1.0",
    "@types/node": "^22.20.3",
    "eslint": "^10.10.0",
    "prettier": "^3.9.6",
    "rollup": "^4.18.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.70.0",
    "vitest": "^5.0.1"
  },
  "dependencies": {
    "decimal.js": "10.6.0"
  }
}
